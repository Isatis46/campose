<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#476052" /><stroke android:width="3dp" android:color="#6A8274" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#89CBA3" /><stroke android:width="4dp" android:color="#F4F8F5" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/accent" /><stroke android:width="4dp" android:color="#F4F8F5" /></shape>
    </item>
</selector>
